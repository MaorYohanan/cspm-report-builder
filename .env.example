# Copy this file to .env and fill in your values
# Get a Gemini API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: set a bearer token to protect the app
APP_TOKEN=
# Rate limiting: max POST/DELETE requests per window per IP (0 = disabled)
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW=60

# Wizi (Wiz) integration — service account with READ permissions
WIZI_CLIENT_ID=
WIZI_CLIENT_SECRET=
WIZI_AUTH_URL=https://auth.app.wiz.io/oauth/token
WIZI_API_URL=https://api.il1.app.wiz.io/graphql

# Database — leave empty to use local SQLite (dev). Set to a PostgreSQL URL for production.
# Example (Cloud SQL): postgresql+psycopg2://user:pass@/dbname?host=/cloudsql/project:region:instance
DATABASE_URL=

# Google OAuth — leave all empty to disable OAuth (APP_TOKEN gate still applies if set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Domain whitelist: only accounts from this domain can log in (e.g. yourcompany.com). Empty = any Google account.
ALLOWED_DOMAIN=
# Email auto-granted Admin role on first login when the Users table is empty
INITIAL_ADMIN_EMAIL=
# Flask session signing key — MANDATORY in production.
# If unset when DATABASE_URL is set, the app logs CRITICAL and all sessions are
# lost on every container restart. Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Set to 1 to force Secure flag on session cookies (required on HTTPS).
# Defaults to True when DATABASE_URL is set. Set to 0 on HTTP-only staging.
SECURE_COOKIES=

# GCS evidence storage — not currently used; evidence stored as base64 inline.
GCS_BUCKET_NAME=
